# Copy this file to ".env" and fill in a key. Never commit .env.

# ── Default: Gemini free tier ──────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ── Switch providers (optional) ────────────────────────────────────────
# MUSE_PROVIDER=gemini      # gemini (default) | ollama | anthropic
# MUSE_FALLBACK=ollama      # auto-retry here if primary fails. 'none' to disable. (default: ollama)

# Local & free (no key needed), needs Ollama running:
# MUSE_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1:8b

# Best quality (paid):
# MUSE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MUSE_MODEL=claude-sonnet-5

# PORT=8787
