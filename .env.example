# Copy this file to ".env" and fill in a key. Never commit .env.

# ── Default: Groq free tier ────────────────────────────────────────────
# Free key at https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # or openai/gpt-oss-20b for more speed

# ── Switch providers (optional) ────────────────────────────────────────
# MUSE_PROVIDER=groq        # groq (default) | ollama | gemini | anthropic
# MUSE_FALLBACK=ollama      # auto-retry here if the primary fails. 'none' to disable.

# Fully local & free (no key), needs Ollama running:
# MUSE_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:14b          # ~9 GB; run: ollama pull qwen3:14b

# Google free tier — key must start with AIzaSy (from aistudio.google.com/apikey):
# MUSE_PROVIDER=gemini
# GEMINI_API_KEY=

# Paid:
# MUSE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MUSE_MODEL=claude-sonnet-5

# ── Saving your work: Supabase (optional) ──────────────────────────────
# Leave both blank and workspaces stay in this browser (IndexedDB) — the app
# works exactly the same, it just can't follow you to another machine.
#
# Fill them in and workspaces move to your Supabase account, behind a magic-link
# sign-in, with mood-board images in a private storage bucket.
#   1. Create a project at https://supabase.com/dashboard
#   2. Run supabase/migrations/*.sql in the SQL editor (Project → SQL Editor),
#      or let the GitHub integration apply it — it reads supabase/migrations.
#   3. Copy Project URL + anon public key from Project Settings → API
# Both values are safe in the browser: row-level security is what protects the
# data, and every policy is "your own rows only".
# VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ── Local-only services (mood-board vision + image generation) ──────────
# OLLAMA_VISION_MODEL=llava:7b
# COMFY_URL=http://127.0.0.1:8188

# PORT=8788
